# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-here-generate-with-secrets.token_hex

# OpenAI Configuration
OPENAI_API_KEY=sk-proj-YOUR_OPENAI_KEY_HERE
OPENAI_MODEL=gpt-4o-mini  # Opciones: gpt-4o-mini (recomendado), gpt-4o, gpt-3.5-turbo
OPENAI_MAX_TOKENS=1000  # Tokens máximos por respuesta (gpt-4o-mini soporta hasta 16,384)
OPENAI_TEMPERATURE=0.7  # Creatividad: 0.0 (determinista) a 1.0 (creativo)

# Twilio Configuration
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER=+14155238886

# Database Configuration
# PostgreSQL (recommended for production)
DATABASE_URL=postgresql://user:password@localhost:5432/bjj_academy

# Application Configuration
APP_NAME=BJJ Academy Bot
APP_VERSION=1.0.0
MAX_CONVERSATION_HISTORY=10

# Redis Configuration (for Celery and Reminders)
REDIS_HOST=your-redis-host.cloud.redislabs.com
REDIS_PORT=19503
REDIS_PASSWORD=your-redis-password-here
REDIS_USERNAME=default

# Celery Configuration
# IMPORTANTE: Redis Cloud Free tier solo permite DB 0, por eso ambos usan /0
CELERY_BROKER_URL=redis://default:your-redis-password@your-redis-host:19503/0
CELERY_RESULT_BACKEND=redis://default:your-redis-password@your-redis-host:19503/0

# Alternative: Local Redis (for development)
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1
